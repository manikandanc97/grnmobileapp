{
  "expo": {
    "name": "GRN",
    "slug": "grnmobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/grn-icon.png",
    "scheme": "grnconstruction",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.grnconstruction.app",
      "icon": "./assets/images/grn-icon.png"
    },
    "android": {
      "package": "com.grnconstruction.app",
      "adaptiveIcon": {
        "backgroundColor": "#C9863F",
        "foregroundImage": "./assets/images/grn-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C9863F",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c846f7f6-5101-4e25-b4b0-c4fb3b4bb4fe"
      }
    },
    "owner": "grnconstruction"
  }
}
